{
  "id": "claude-code",
  "name": "Claude Code",
  "notes": "Flags verified against Claude Code's own --help. Usage is 'claude [options] [command] [prompt]': the prompt is a bare positional, so it is covered by the default-deny rule rather than by any flag listed here.",
  "flags_verified": true,
  "comms": ["claude", "claude.exe"],
  "path_markers": ["@anthropic-ai/claude-code", "/claude-code/"],
  "persistent_markers": [
    "remote-control",
    "--input-format stream-json",
    "--replay-user-messages"
  ],
  "redact": {
    "secret_flags": [
      "-p",
      "--print",
      "--prompt",
      "--system-prompt",
      "--system-prompt-file",
      "--append-system-prompt",
      "--append-system-prompt-file",
      "--agent",
      "--agents",
      "--session-id",
      "-r",
      "--resume",
      "--fork-session",
      "--add-dir",
      "--mcp-config",
      "--settings",
      "--plugin-dir",
      "--plugin-url",
      "--json-schema",
      "--debug-file",
      "--cloud",
      "--environment",
      "--teleport",
      "--from-pr",
      "-n",
      "--name",
      "--remote-control-session-name-prefix",
      "--file",
      "--sdk-url",
      "--api-key",
      "--anthropic-api-key",
      "--auth-token"
    ],
    "keep_flags": [
      "--model",
      "--fallback-model",
      "--permission-mode",
      "--output-format",
      "--input-format",
      "--effort",
      "--autocompact",
      "--max-budget-usd",
      "--setting-sources",
      "--allowedTools",
      "--allowed-tools",
      "--disallowedTools",
      "--disallowed-tools",
      "--tools",
      "--betas",
      "--ide",
      "-d",
      "--debug"
    ],
    "safe_words": [
      "agent",
      "agents",
      "auth",
      "config",
      "doctor",
      "gateway",
      "import",
      "install",
      "mcp",
      "migrate-installer",
      "plugin",
      "project",
      "remote-control",
      "review",
      "setup-token",
      "update",
      "add",
      "get",
      "list",
      "remove",
      "serve",
      "set",
      "status"
    ]
  }
}
