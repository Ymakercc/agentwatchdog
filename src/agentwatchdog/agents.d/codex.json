{
  "id": "codex",
  "name": "OpenAI Codex CLI",
  "notes": "Flags verified against Codex CLI's own --help. Two traps worth knowing: the prompt is a positional at the TOP level too ('codex [OPTIONS] [PROMPT]'), not only after 'exec'; and '-p' here is --profile, not a prompt flag as it is in Claude Code. Copying another agent's rules across would redact the wrong argument and leave the prompt in the log.",
  "flags_verified": true,
  "comms": ["codex"],
  "path_markers": ["@openai/codex", "/codex/"],
  "persistent_markers": ["mcp-server", "app-server", "exec-server", "remote-control"],
  "redact": {
    "secret_flags": [
      "-c",
      "--config",
      "--remote",
      "--remote-auth-token-env",
      "-C",
      "--cd",
      "--add-dir",
      "-i",
      "--image",
      "-o",
      "--output-last-message",
      "--output-schema",
      "--api-key"
    ],
    "keep_flags": [
      "-m",
      "--model",
      "-s",
      "--sandbox",
      "-p",
      "--profile",
      "-a",
      "--ask-for-approval",
      "--local-provider",
      "--enable",
      "--disable",
      "--color"
    ],
    "safe_words": [
      "a",
      "app-server",
      "apply",
      "archive",
      "cloud",
      "completion",
      "debug",
      "delete",
      "doctor",
      "e",
      "exec",
      "exec-server",
      "features",
      "fork",
      "help",
      "login",
      "logout",
      "mcp",
      "mcp-server",
      "plugin",
      "remote-control",
      "resume",
      "review",
      "sandbox",
      "unarchive",
      "update"
    ]
  }
}
