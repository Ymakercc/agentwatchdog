{
  "id": "aider",
  "name": "aider",
  "notes": "Flags verified against aider 0.86.2 --help in a clean venv. The prompt travels as -m/--message/--msg; --commit-prompt also carries free text. Filenames are positionals and fall to the default-deny rule - redacted, which loses some detail but never leaks a name. The path marker is '/bin/aider', not '/aider': the looser form also matched unrelated interpreters inside directories with 'aider' in their name (found live, as a pip process in an aider venv reported as the agent).",
  "flags_verified": true,
  "comms": ["aider"],
  "path_markers": ["/bin/aider"],
  "persistent_markers": ["--gui", "--browser", "--watch-files"],
  "redact": {
    "secret_flags": [
      "-m",
      "--message",
      "--msg",
      "-f",
      "--message-file",
      "--commit-prompt",
      "--file",
      "--read",
      "--load",
      "--apply",
      "--aiderignore",
      "--env-file",
      "-c",
      "--config",
      "--api-key",
      "--openai-api-key",
      "--anthropic-api-key",
      "--openai-api-base",
      "--openai-organization-id",
      "--openai-api-deployment-id",
      "--set-env",
      "--alias",
      "--chat-history-file",
      "--input-history-file",
      "--llm-history-file",
      "--analytics-log",
      "--analytics-posthog-project-api-key",
      "--analytics-posthog-host",
      "--model-settings-file",
      "--model-metadata-file",
      "--lint-cmd",
      "--test-cmd",
      "--notifications-command"
    ],
    "keep_flags": [
      "--model",
      "--weak-model",
      "--editor-model",
      "--edit-format",
      "--chat-mode",
      "--editor-edit-format",
      "--reasoning-effort",
      "--thinking-tokens",
      "--map-tokens",
      "--map-refresh",
      "--timeout",
      "--encoding",
      "--line-endings",
      "--chat-language",
      "--commit-language",
      "--voice-language",
      "--voice-format"
    ],
    "safe_words": []
  }
}
