# Cloudflare Pages headers.
#
# The site has no inline script and no inline style, so the policy can be
# strict rather than nominally present. Nothing is loaded from anywhere else:
# the fonts are self-hosted precisely so that reading this page does not tell
# a third party you read it.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Revalidate the markup, but let the rest sit in cache. Fonts are the bulk of
# the payload and never change within a build, so they get a year.
#
# These paths must not overlap. Cloudflare applies every matching rule and
# concatenates same-named headers, so a broad /assets/* alongside a narrower
# /assets/fonts/* produces "max-age=604800, public, max-age=31536000" — two
# values in one header, of which the browser honours the shorter.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=604800

/assets/js/*
  Cache-Control: public, max-age=604800

/assets/og.png
  Cache-Control: public, max-age=604800

/assets/favicon.svg
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate
