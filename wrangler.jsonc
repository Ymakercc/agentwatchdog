// Deployment config for the project's website only.
//
// agentwatchdog itself is a Python CLI with no runtime dependencies and
// nothing to do with Cloudflare — this file exists purely so that pushing to
// main republishes the static site in site/, which is generated by
// web/build.py and committed.
//
// There is no Worker script: `assets` alone serves the directory, so no
// JavaScript runs on any request.
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "agentwatchdog",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
